<odoo>

    <template
        id="greencheck_inscription"
        name="GreenCheck Inscription"
    >

        <t t-call="website.layout">

            <div id="wrap" class="greencheck-inscription-page">

                <main class="greencheck-inscription-main">

                    <div class="greencheck-inscription-container">

                        <div class="greencheck-inscription-card">

                            <div class="greencheck-inscription-header">

                                <div class="greencheck-inscription-icon">
                                    🌱
                                </div>

                                <h1>
                                    Créer votre compte
                                </h1>

                                <p>
                                    Rejoignez GreenCheck et suivez vos diagnostics de plantes.
                                </p>

                            </div>


                            <form
                                class="greencheck-inscription-form"
                                method="post"
                                action="/web/signup"
                            >

                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>


                                <div class="greencheck-form-group">

                                    <label for="inscription-name">
                                        Nom
                                    </label>

                                    <input
                                        type="text"
                                        id="inscription-name"
                                        name="name"
                                        class="greencheck-form-input"
                                        placeholder="Votre nom"
                                        autocomplete="name"
                                        required="required"
                                    />

                                </div>


                                <div class="greencheck-form-group">

                                    <label for="inscription-email">
                                        Adresse e-mail
                                    </label>

                                    <input
                                        type="email"
                                        id="inscription-email"
                                        name="login"
                                        class="greencheck-form-input"
                                        placeholder="votre@email.com"
                                        autocomplete="email"
                                        required="required"
                                    />

                                </div>


                                <div class="greencheck-form-group">

                                    <label for="inscription-password">
                                        Mot de passe
                                    </label>

                                    <input
                                        type="password"
                                        id="inscription-password"
                                        name="password"
                                        class="greencheck-form-input"
                                        placeholder="Votre mot de passe"
                                        autocomplete="new-password"
                                        required="required"
                                    />

                                </div>


                                <div class="greencheck-form-group">

                                    <label for="inscription-password-confirmation">
                                        Confirmation du mot de passe
                                    </label>

                                    <input
                                        type="password"
                                        id="inscription-password-confirmation"
                                        name="confirm_password"
                                        class="greencheck-form-input"
                                        placeholder="Confirmez votre mot de passe"
                                        autocomplete="new-password"
                                        required="required"
                                    />

                                </div>


                                <button
                                    type="submit"
                                    class="greencheck-btn greencheck-btn-primary greencheck-inscription-submit"
                                >
                                    Créer mon compte
                                </button>

                            </form>


                            <div class="greencheck-inscription-login">

                                <span>
                                    Déjà un compte ?
                                </span>

                                <a href="/web/login">
                                    Se connecter
                                </a>

                            </div>

                        </div>

                    </div>

                </main>

            </div>

        </t>

    </template>

</odoo>

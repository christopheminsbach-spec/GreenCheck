<odoo>

    <!-- =========================================================
         GreenCheck — Header principal
         ========================================================= -->

    <template
        id="greencheck_header"
        inherit_id="website.template_header_default"
        name="GreenCheck Header">

        <xpath expr="//div[@id='o_main_nav']" position="replace">

            <div id="o_main_nav"
                 class="greencheck-header">

                <!-- Logo -->
                <a href="/"
                   class="greencheck-logo"
                   aria-label="GreenCheck - Accueil">

                    <span class="greencheck-logo-icon">
                        🌱
                    </span>

                    <span class="greencheck-logo-text">
                        GreenCheck
                    </span>

                </a>


                <!-- Bouton hamburger mobile -->
                <button type="button"
                        class="greencheck-menu-toggle"
                        aria-label="Ouvrir le menu"
                        aria-expanded="false"
                        aria-controls="greencheck-main-menu">

                    <span class="greencheck-menu-icon"
                          aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                </button>


                <!-- Navigation principale -->
                <nav class="greencheck-navigation"
                     aria-label="Navigation principale">

                    <ul id="greencheck-main-menu"
                        class="greencheck-menu">

                        <li class="greencheck-menu-item">
                            <a href="/"
                               class="greencheck-nav-link">
                                Accueil
                            </a>
                        </li>

                        <li class="greencheck-menu-item">
                            <a href="/diagnostic-ia"
                               class="greencheck-nav-link">
                                Diagnostic IA
                            </a>
                        </li>

                        <li class="greencheck-menu-item">
                            <a href="/fonctionnement"
                               class="greencheck-nav-link">
                                Fonctionnement
                            </a>
                        </li>

                        <li class="greencheck-menu-item">
                            <a href="/a-propos"
                               class="greencheck-nav-link">
                                À propos
                            </a>
                        </li>

                        <li class="greencheck-menu-item">
                            <a href="/contact"
                               class="greencheck-nav-link">
                                Contact
                            </a>
                        </li>

                    </ul>

                </nav>


                <!-- CTA -->
                <a href="/diagnostic-ia"
                   class="greencheck-header-cta">

                    <span>
                        Commencer un diagnostic
                    </span>

                    <span class="greencheck-cta-arrow"
                          aria-hidden="true">
                        →
                    </span>

                </a>

            </div>

        </xpath>

    </template>


    <!-- =========================================================
         Suppression du header mobile standard Odoo
         ========================================================= -->

    <template
        id="greencheck_remove_mobile_header"
        inherit_id="website.layout"
        name="GreenCheck Remove Default Mobile Header">

        <xpath
            expr="//header[@id='top']/t[@t-call='website.template_header_mobile']"
            position="replace"/>

    </template>

</odoo>
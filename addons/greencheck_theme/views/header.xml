<odoo>

    <template
        id="greencheck_header"
        inherit_id="website.template_header_default">

        <xpath expr="//div[@id='o_main_nav']"
               position="replace">

            <div id="o_main_nav"
                 class="container greencheck-header">

                <!-- Logo -->
                <a href="/"
                   class="navbar-brand">
                    <span>
                        🌱 GreenCheck
                    </span>
                </a>

                <!-- Menu principal -->
                <ul class="nav navbar-nav">

                    <!-- Accueil -->
                    <li class="nav-item">
                        <a href="/"
                           class="nav-link">
                            Accueil
                        </a>
                    </li>

                    <!-- Diagnostic IA -->
                    <li class="nav-item">
                        <a href="/diagnostic-ia"
                           class="nav-link">
                            Diagnostic IA
                        </a>
                    </li>

                    <!-- Fonctionnement -->
                    <li class="nav-item">
                        <a href="/fonctionnement"
                           class="nav-link">
                            Fonctionnement
                        </a>
                    </li>

                    <!-- À propos -->
                    <li class="nav-item">
                        <a href="/a-propos"
                           class="nav-link">
                            À propos
                        </a>
                    </li>

                    <!-- Contact -->
                    <li class="nav-item">
                        <a href="/contact"
                           class="nav-link">
                            Contact
                        </a>
                    </li>

                </ul>

                <!-- Bouton CTA -->
                <a href="/diagnostic-ia"
                   class="btn btn-success">
                    Commencer un diagnostic
                </a>

            </div>

        </xpath>

    </template>

</odoo>
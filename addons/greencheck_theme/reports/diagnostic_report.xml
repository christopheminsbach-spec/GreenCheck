<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="diagnostic_report"
        name="GreenCheck - Fiche diagnostic"
    >

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="diagnostic">

                <div class="page greencheck-report">

                    <div class="greencheck-report-header">

                        <h1 class="greencheck-report-brand">
                            GreenCheck by AgroNovaTech
                        </h1>

                        <h2 class="greencheck-report-title">
                            Diagnostic intelligent de plantes
                        </h2>

                        <h3>
                            <t t-esc="diagnostic.name"/>
                        </h3>

                        <p class="greencheck-report-meta">
                            <strong>Date du diagnostic :</strong>
                            <t t-esc="diagnostic.date_diagnostic"/>
                        </p>

                    </div>

                    <div class="greencheck-report-section">

                        <h3 class="greencheck-report-section-title">
                            Contexte de la plante
                        </h3>

                        <table class="greencheck-report-context">
                            <tbody>

                                <tr t-if="diagnostic.plant_type">
                                    <td class="greencheck-report-context-label">
                                        Type de plante
                                    </td>
                                    <td>
                                        <t t-esc="diagnostic.plant_type"/>
                                    </td>
                                </tr>

                                <tr t-if="diagnostic.location">
                                    <td class="greencheck-report-context-label">
                                        Localisation
                                    </td>
                                    <td>
                                        <t t-esc="diagnostic.location"/>
                                    </td>
                                </tr>

                                <tr t-if="diagnostic.exposure">
                                    <td class="greencheck-report-context-label">
                                        Exposition
                                    </td>
                                    <td>
                                        <t t-esc="diagnostic.exposure"/>
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                    </div>

                    <div
                        t-if="diagnostic.image"
                        class="greencheck-report-section"
                    >

                        <h3 class="greencheck-report-section-title">
                            Photo de la plante
                        </h3>

                        <div class="greencheck-report-photo">

                            <img
                                t-att-src="'data:image/*;base64,%s' % diagnostic.image.decode('utf-8')"
                                alt="Photo de la plante"
                            />

                        </div>

                    </div>

                    <div class="greencheck-report-section">

                        <h3 class="greencheck-report-section-title">
                            Résultat de l'analyse
                        </h3>

                        <div
                            t-if="diagnostic.ai_result"
                            class="greencheck-report-result"
                        >

                            <span class="greencheck-report-result-label">
                                Résultat
                            </span>

                            <t t-esc="diagnostic.ai_result"/>

                        </div>

                        <p
                            t-if="diagnostic.ai_confidence"
                            class="greencheck-report-confidence"
                        >

                            <span class="greencheck-report-confidence-label">
                                Confiance :
                            </span>

                            <t t-esc="diagnostic.ai_confidence * 100"/> %

                        </p>

                    </div>

                    <div
                        t-if="diagnostic.recommendations"
                        class="greencheck-report-section"
                    >

                        <h3 class="greencheck-report-section-title">
                            Recommandations
                        </h3>

                        <div class="greencheck-report-recommendations">
                            <t t-esc="diagnostic.recommendations"/>
                        </div>

                    </div>

                </div>

            </t>

        </t>

    </template>

    <record
        id="action_report_diagnostic"
        model="ir.actions.report"
    >

        <field name="name">
            Fiche diagnostic
        </field>

        <field name="model">plant.diagnostic</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">greencheck_theme.diagnostic_report</field>

        <field name="report_file">greencheck_theme.diagnostic_report</field>

        <field
            name="print_report_name"
        >
            'Diagnostic GreenCheck - %s' % (object.name)
        </field>

        <field
            name="binding_model_id"
            ref="greencheck_theme.model_plant_diagnostic"
        />

        <field name="binding_type">report</field>

    </record>

</odoo>
